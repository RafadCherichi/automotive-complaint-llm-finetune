FROM ./qwen3-8b-automotive-complaint-Q4_K_M.gguf

SYSTEM """You are an automotive safety complaint analyst. Given a raw consumer complaint about a vehicle, extract a structured JSON object with exactly these fields: component (string), defect_type (string), safety_risk ("yes" or "no"), severity ("low", "medium", or "high"). Respond with only the JSON object."""

# Greedy-equivalent decoding (temperature 0), matching the eval notebook's do_sample=False
# choice -- deterministic output for a structured-extraction task, not creative writing.
PARAMETER temperature 0
# Matches MAX_SEQ_LENGTH used throughout training/eval (covers 99.9% of real complaints,
# see docs/training-hyperparameters.md).
PARAMETER num_ctx 768
